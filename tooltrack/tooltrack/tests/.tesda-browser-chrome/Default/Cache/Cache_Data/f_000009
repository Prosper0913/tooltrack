#returnPage #rtBorrowerCard,#returnPage #returnAllCard{scroll-margin-top:112px}
@media(min-width:1050px){
 #returnPage .return-home{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:16px 24px}
 #returnPage .return-home>.bw-h:first-of-type{grid-column:1;grid-row:2}
 #returnPage .return-home>.bw-h:last-of-type{grid-column:2;grid-row:2}
 #returnPage .return-home>.bw-quick{grid-column:1;grid-row:3;grid-template-columns:repeat(4,minmax(0,1fr))}
 #returnPage .return-home>.bw-stats{grid-column:2;grid-row:3}
}
@media(max-width:992px){#returnPage #rtWorkspace .return-layout{grid-template-columns:minmax(0,1fr);gap:16px}#returnPage .return-summary-main{grid-template-columns:minmax(0,1fr) auto}#returnPage .return-summary .rt-total{grid-column:1/-1;grid-row:2}#returnPage .return-summary{padding:16px;bottom:10px}}
@media(max-width:600px){#returnPage .return-summary-main{grid-template-columns:minmax(0,1fr);gap:10px}#returnPage #raSubmitBtn{grid-row:3;width:100%;min-width:0}#returnPage .return-summary{padding:12px 14px;bottom:0;border-radius:16px 16px 0 0;padding-bottom:calc(12px + env(safe-area-inset-bottom,0px))}#returnPage .return-home .bw-stat span{font-size:11px}#returnPage .return-home .bw-stats{gap:8px}#returnPage .rt-review-counts{grid-template-columns:repeat(2,minmax(0,1fr))}#returnPage .return-summary .rt-impact:empty{display:none}}

/* Shared Borrow/Return navigation palette; existing sizes, spacing and radii are retained. */
.circulation-tabs .card-btn[aria-pressed]{background:#F3F4F6;color:#374151;border-color:#F3F4F6;transition:background-color .15s ease,color .15s ease,border-color .15s ease,box-shadow .15s ease}
.circulation-tabs .card-btn[data-circulation-tab="overdue"][aria-pressed="false"]{background:#FEF2F2;color:#DC2626;border-color:#FEF2F2}
.circulation-tabs .card-btn[aria-pressed="false"]:hover{background:#E5E7EB;border-color:#D1D5DB}
.circulation-tabs .card-btn[data-circulation-tab="overdue"][aria-pressed="false"]:hover{background:#FEE2E2;border-color:#FECACA}
.circulation-tabs .card-btn[aria-pressed="true"]{background:#6D28D9;color:#FFFFFF;border-color:#6D28D9}
.circulation-tabs .card-btn[aria-pressed="true"]:hover{background:#5B21B6;border-color:#5B21B6}
.circulation-tabs .card-btn:focus-visible{outline:3px solid #6D28D9;outline-offset:3px;box-shadow:0 0 0 2px #FFFFFF}
@media(prefers-reduced-motion:reduce){.circulation-tabs .card-btn[aria-pressed]{transition:none}}

/* Transactions paginate headers; their tool details stay inside the report scroll area. */
.report-workspace[data-report="transactions"][data-transactions-grouped="true"] .transaction-report-toggle{position:sticky;left:0;min-width:42px;width:42px;max-width:42px;padding:8px;background:var(--gray-50,#faf8ff);z-index:3}
.report-workspace[data-report="transactions"][data-transactions-grouped="true"] th.transaction-report-toggle{top:0;z-index:7}
.report-workspace[data-report="transactions"][data-transactions-grouped="true"] .transaction-report-summary .report-identity,.report-workspace[data-report="transactions"][data-transactions-grouped="true"] #reportTableHead .report-identity{left:42px}
.report-workspace[data-report="transactions"] .transaction-report-summary>td{font-weight:500;vertical-align:middle}
.report-workspace[data-report="transactions"] .transaction-report-summary>td small{display:block;margin-top:5px;font-size:12px;color:var(--gray-500,#64748b)}
.report-workspace[data-report="transactions"] .transaction-report-details>td{max-width:0;padding:12px 16px 18px;background:#faf8ff!important;border-bottom:1px solid #e9e3f3}
/* Size against the spanning cell, without letting nested content widen the parent table. */
.report-workspace[data-report="transactions"] .transaction-report-detail-scroll{box-sizing:border-box;width:100%;min-width:0;max-width:100%;overflow-x:auto;border:1px solid #e9e3f3;border-radius:8px;background:#fff}
.report-workspace[data-report="transactions"] .transaction-report-tools{min-width:800px;width:100%;font-size:13px}
.report-workspace[data-report="transactions"] .transaction-report-tools caption{text-align:left;padding:10px 12px;font-size:12px;font-weight:600;color:var(--gray-600,#475569);white-space:normal}
.report-workspace[data-report="transactions"] .transaction-report-tools th{position:static;min-width:80px;font-size:12px;white-space:normal}
.report-workspace[data-report="transactions"] .transaction-report-tools td{position:static;vertical-align:top;padding:10px 12px;white-space:normal}
.report-workspace[data-report="transactions"] .transaction-report-tools td:first-child{min-width:170px}
.transaction-report-tools td small{display:block;margin-top:4px;color:var(--gray-500,#64748b);font-size:11px}
.transaction-report-tools code{overflow-wrap:anywhere}
.transaction-report-warning{color:#b45309!important}
@media(max-width:640px){.report-workspace[data-report="transactions"] .transaction-report-details>td{padding:10px 6px 14px}.report-workspace[data-report="transactions"] .transaction-report-toggle .action-btn{min-width:32px;min-height:36px}}

