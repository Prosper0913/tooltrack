/* ═══════════════════════════════════════════════════════════════════════════
   BORROW TAB — every rule is scoped to #borrowPage (the Return page shares .br-layout / .br-card).
   > 1200px  original two-column desktop layout (form card + Selected Tools card)
   ≤ 1200px  single column, section by section, with the start strip (hero, quick actions, overview)
   ≤  768px  phone: full-screen scan mode, edge-to-edge sticky confirm bar, full-screen sheets
═══════════════════════════════════════════════════════════════════════════ */
#borrowPage{--bw-pad:32px}
#borrowPage [hidden]{display:none !important}
body.br-lock{overflow:hidden}

/* ── Desktop base: new parts stay out of the way ── */
:is(#borrowPage,#returnPage) .bw-home,#borrowPage .br-sec-title,#borrowPage .br-scan{display:none}
#borrowPage .br-form{overflow:clip}                 /* "hidden" would stop the confirm bar sticking to the window */
#borrowPage .br-hint{font-size:12px;color:var(--gray-500);margin:-8px 0 12px;min-height:16px}
#borrowPage .br-dd{position:absolute;top:100%;left:0;right:0;z-index:40;background:#fff;border:1px solid var(--gray-200);border-radius:8px;margin-top:4px;max-height:240px;overflow-y:auto;box-shadow:0 10px 30px rgba(0,0,0,.12)}
#borrowPage .br-dd.tool{margin-top:-10px}

/* icon tile (cart lines, tool card, review list) */
#borrowPage .bt-ico{flex:none;width:44px;height:44px;border-radius:12px;background:var(--primary-bg);border:1px solid #ddd6fe;color:var(--primary);display:inline-flex;align-items:center;justify-content:center;font-size:18px}

/* "Tool found" card */
#borrowPage .br-tool{display:flex;align-items:center;gap:12px;padding:12px;margin:0 0 16px;border:1.5px solid #ddd6fe;background:var(--primary-bg);border-radius:12px}
#borrowPage .br-tool .bt-ico{background:#fff}
#borrowPage .br-tool-main{flex:1;min-width:0}
#borrowPage .br-tool-main b{display:block;font-size:15px;font-weight:600;color:var(--gray-800);overflow-wrap:anywhere}
#borrowPage .br-tool-main small{display:block;font-size:12px;color:var(--gray-500);margin-top:2px}
#borrowPage .br-avail{flex:none;font-size:12px;font-weight:600;padding:4px 10px;border-radius:999px;background:var(--success-bg);color:#065f46}
#borrowPage .br-avail.low{background:var(--warning-bg);color:#92400e}
#borrowPage .has-tool #borrowToolSelectHint{display:none}

/* quantity stepper + Add Tool */
#borrowPage .bt-addrow{display:flex;gap:10px;align-items:stretch;margin-bottom:16px}
#borrowPage .br-qty{flex:1;min-width:0;display:flex;align-items:stretch;gap:6px}
#borrowPage .br-qty .form-input-full{margin:0;flex:1;min-width:0;text-align:center;font-weight:600;-moz-appearance:textfield}
#borrowPage .br-qty .form-input-full::-webkit-outer-spin-button,#borrowPage .br-qty .form-input-full::-webkit-inner-spin-button,
#borrowPage .bt-qty::-webkit-outer-spin-button,#borrowPage .bt-qty::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
#borrowPage .br-qty-btn,#borrowPage .bt-step,#borrowPage .bt-del{flex:none;border-radius:10px;border:1.5px solid var(--gray-200);background:#fff;color:var(--primary);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;font-size:13px;transition:background .15s,border-color .15s}
#borrowPage .br-qty-btn{width:44px}
#borrowPage .bt-step,#borrowPage .bt-del{width:36px;height:36px}
#borrowPage .bt-del{color:var(--danger);border-color:#fecaca}
#borrowPage .br-qty-btn:hover:not(:disabled),#borrowPage .bt-step:hover:not(:disabled){background:var(--primary-bg);border-color:var(--primary)}
#borrowPage .bt-del:hover:not(:disabled){background:var(--danger-bg)}
#borrowPage .br-qty-btn:disabled,#borrowPage .bt-step:disabled,#borrowPage .bt-del:disabled{opacity:.4;cursor:not-allowed}
#borrowPage .bt-add{flex:none;padding:0 20px;font-size:14px;border-radius:10px;white-space:nowrap}
#borrowPage button:focus-visible,#borrowPage .bt-qty:focus-visible{outline:2px solid var(--primary);outline-offset:2px}

/* borrower information card */
#borrowPage .br-bcard{display:flex;align-items:center;gap:12px;padding:12px;margin:-4px 0 16px;border:1.5px solid #ddd6fe;background:var(--primary-bg);border-radius:12px}
#borrowPage .br-avatar{flex:none;width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--primary-dark),var(--primary-light));color:#fff;font-weight:600;font-size:15px;display:flex;align-items:center;justify-content:center}
#borrowPage .br-bcard-main{flex:1;min-width:0}
#borrowPage .br-bcard-main b{display:block;font-size:15px;font-weight:600;color:var(--gray-800);overflow-wrap:anywhere}
#borrowPage .br-bcard-main small{display:block;font-size:12.5px;color:var(--gray-500);margin-top:1px}
#borrowPage .br-bcard-main .br-loans{color:#92400e;font-weight:500}
#borrowPage .br-type{flex:none;font-size:11.5px;font-weight:600;padding:3px 10px;border-radius:999px;background:#fff;color:var(--primary-dark);border:1px solid #ddd6fe}
#borrowPage .br-bcard-x{flex:none;width:36px;height:36px;border:none;border-radius:10px;background:transparent;color:var(--gray-500);cursor:pointer}
#borrowPage .br-bcard-x:hover{background:#fff;color:var(--danger)}

/* Selected Tools (cart) */
#borrowPage .bt-count{margin-left:auto;font-size:12px;font-weight:600;color:var(--primary);background:var(--primary-bg);padding:4px 12px;border-radius:999px;white-space:nowrap}
#borrowPage .bt-line{display:grid;grid-template-columns:44px minmax(0,1fr) auto;align-items:center;gap:12px;padding:14px 0;border-bottom:1px solid var(--gray-100)}
#borrowPage .bt-line:first-child{padding-top:0}
#borrowPage .bt-line.is-new{animation:brPop .3s ease-out}
@keyframes brPop{from{background:var(--primary-bg)}to{background:transparent}}
#borrowPage .bt-info{min-width:0}
#borrowPage .bt-name{font-size:15px;font-weight:600;color:var(--gray-800);line-height:1.3;overflow-wrap:anywhere}
#borrowPage .bt-meta{font-size:12px;color:var(--gray-500);margin-top:2px}
#borrowPage .bt-ctrl{display:flex;align-items:center;gap:6px}
#borrowPage .bt-qty{width:52px;height:36px;text-align:center;font-size:15px;font-weight:600;font-family:inherit;border:1.5px solid var(--gray-200);border-radius:10px;-moz-appearance:textfield}
#borrowPage .bt-del{margin-left:4px}
#borrowPage .bt-total{display:flex;justify-content:space-between;align-items:center;margin-top:16px;padding:14px 16px;background:var(--primary-bg);border-radius:12px;color:var(--primary-dark);font-size:14px;font-weight:600}
#borrowPage .bt-total b{font-size:20px}

/* sticky confirm bar — desktop: the same full-width button as before, now pinned to the window bottom while the form is on screen */
#borrowPage .br-bar{position:sticky;bottom:0;z-index:6;margin:-10px -24px -24px;padding:14px 24px 24px;background:linear-gradient(to bottom,rgba(255,255,255,0),#fff 14px)}
#borrowPage .br-bar .btn-primary-full{margin-top:0}
#borrowPage .btn-primary-full:disabled{opacity:.7;cursor:progress}
#borrowPage .br-bar-sum{display:none}

/* sheets (review / history): centred card on desktop-size screens, full screen on phones */
#borrowPage .br-sheet{position:fixed;inset:0;z-index:950;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(30,10,60,.5)}
#borrowPage .br-sheet-card{display:flex;flex-direction:column;width:100%;max-width:560px;max-height:min(760px,100%);background:var(--gray-50);border-radius:20px;overflow:hidden;box-shadow:0 24px 60px rgba(30,10,60,.35)}
#borrowPage .br-sheet-top{flex:none;display:flex;align-items:center;gap:8px;padding:0 8px;min-height:56px;background:linear-gradient(90deg,var(--primary),var(--primary-dark));color:#fff}
#borrowPage .br-sheet-top h2{font-size:17px;font-weight:600}
#borrowPage .br-sheet-x,#borrowPage .br-scan-back{width:44px;height:44px;border:none;border-radius:12px;background:rgba(255,255,255,.14);color:#fff;cursor:pointer;font-size:16px}
#borrowPage .br-sheet-body{flex:1;min-height:0;overflow-y:auto;padding:16px;overscroll-behavior:contain}
#borrowPage .br-sheet-foot{flex:none;display:flex;flex-direction:column;gap:10px;padding:12px 16px;background:#fff;border-top:1px solid var(--gray-200)}
#borrowPage .br-sheet-foot .btn-primary-full{margin:0;height:48px;font-size:15px;border-radius:12px}
#borrowPage .br-btn-outline{height:48px;border-radius:12px;border:1.5px solid var(--primary);background:#fff;color:var(--primary);font:600 15px/1 inherit;font-family:inherit;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px}
#borrowPage .br-btn-outline:disabled{opacity:.5;cursor:not-allowed}
#borrowPage .br-sheet-h{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:700;color:var(--gray-800);margin:4px 0 10px}
#borrowPage .br-sheet-h i{color:var(--primary)}
#borrowPage .br-sheet .br-bcard{margin:0 0 18px}
#borrowPage .br-ritem{display:flex;align-items:center;gap:12px;padding:10px 12px;margin-bottom:8px;background:#fff;border:1px solid var(--gray-200);border-radius:12px}
#borrowPage .br-ritem .bt-info{flex:1}
#borrowPage .br-rq{flex:none;font-size:15px;color:var(--primary-dark)}
#borrowPage .br-rmeta{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:16px 0}
#borrowPage .br-rmeta>div{padding:10px 12px;background:#fff;border:1px solid var(--gray-200);border-radius:12px;min-width:0}
#borrowPage .br-rmeta dt{font-size:11.5px;color:var(--gray-500)}
#borrowPage .br-rmeta dd{font-size:14px;font-weight:600;color:var(--gray-800);overflow-wrap:anywhere;margin:2px 0 0}
#borrowPage .br-note{display:flex;gap:10px;padding:12px;border-radius:12px;background:var(--primary-bg);color:var(--primary-dark);font-size:13px;line-height:1.4}
/* history */
#borrowPage .br-hsearch{position:relative;margin-bottom:12px}
#borrowPage .br-hsearch i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--gray-400);font-size:14px}
#borrowPage .br-hsearch input{width:100%;height:44px;padding:0 14px 0 40px;border:1.5px solid var(--gray-200);border-radius:12px;font-size:16px;font-family:inherit;background:#fff}
#borrowPage .br-chips{display:flex;gap:8px;overflow-x:auto;margin-bottom:14px;padding-bottom:2px}
#borrowPage .br-chips button{flex:none;height:36px;padding:0 14px;border-radius:999px;border:1.5px solid var(--gray-200);background:#fff;font:600 13px/1 inherit;font-family:inherit;color:var(--gray-600);cursor:pointer}
#borrowPage .br-chips button.on{background:var(--primary);border-color:var(--primary);color:#fff}
#borrowPage .br-hrow{background:#fff;border:1px solid var(--gray-200);border-radius:14px;padding:12px 14px;margin-bottom:10px}
#borrowPage .br-hrow-top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px}
#borrowPage .br-hrow-top code{font-size:12px;color:var(--gray-500)}
#borrowPage .br-hrow-main{font-size:14.5px;color:var(--gray-800);overflow-wrap:anywhere}
#borrowPage .br-hrow-main span{color:var(--gray-500);font-size:13px}
#borrowPage .br-hrow-main em{font-style:normal;font-weight:700;color:var(--primary-dark)}
#borrowPage .br-hrow-sub{display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--gray-500);margin-top:4px}
#borrowPage .br-hrow-sub i{width:14px;text-align:center}
#borrowPage .br-hempty,#borrowPage .br-hmore{text-align:center;color:var(--gray-500);font-size:13px;padding:24px 8px}
#borrowPage .br-hmore{padding:8px}

/* ═══ ≤ 1200px — phone + tablet: single column, section by section ═══ */
@media (max-width:1200px){
  #borrowPage .br-layout{display:flex;flex-direction:column;gap:14px;max-width:780px;margin-inline:auto}
  :is(#borrowPage,#returnPage) .bw-home{display:flex;flex-direction:column;gap:12px;order:0}
  #borrowPage .br-form,#borrowPage .br-form>.br-card-body{display:contents}   /* the sections become cards of their own, reordered below */
  #borrowPage .br-form>.br-card-header{display:none}
  #borrowPage .br-sec{background:#fff;border:1px solid var(--gray-200);border-radius:16px;padding:16px;scroll-margin-top:84px}
  #borrowPage #brSecBorrower{order:1}
  #borrowPage #brSecTool{order:2}
  #borrowPage #borrowCartCard{order:3;border-radius:16px;box-shadow:none;scroll-margin-top:84px}
  #borrowPage #brSecLoan{order:4}
  #borrowPage .br-bar{order:5}
  #borrowPage .br-sec-title{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:600;color:var(--gray-800);margin:0 0 14px}
  #borrowPage .br-sec-title i{color:var(--primary);font-size:16px}
  #borrowPage .br-sec:last-of-type .field-label:first-child{margin-top:0}
  #borrowPage #brSecBorrower.has-borrower #borrowerSearchWrap,#borrowPage #brSecBorrower.has-borrower #borrowerSearchLabel{display:none}
  #borrowPage #brBorrowerCard{margin:0}

  /* start strip */
  :is(#borrowPage,#returnPage) .bw-hero{display:flex;flex-direction:column;gap:14px;padding:20px;border-radius:20px;color:#fff;
    background:radial-gradient(120% 140% at 100% 0%,rgba(255,255,255,.22),transparent 55%),linear-gradient(135deg,#5b21b6 0%,#6d28d9 50%,#8b5cf6 100%);box-shadow:0 10px 24px rgba(91,33,182,.28)}
  :is(#borrowPage,#returnPage) .bw-hero-text{text-align:center}
  :is(#borrowPage,#returnPage) .bw-hero-title{font-size:20px;font-weight:700;margin:0}
  :is(#borrowPage,#returnPage) .bw-hero-sub{font-size:13px;color:rgba(255,255,255,.86);margin:4px 0 0}
  :is(#borrowPage,#returnPage) .bw-hero-btn{height:48px;padding:0 24px;border:none;border-radius:14px;background:#fff;color:var(--primary-dark);font:600 15px/1 inherit;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;box-shadow:0 4px 12px rgba(0,0,0,.15)}
  :is(#borrowPage,#returnPage) .bw-hero-btn:active{transform:scale(.98)}
  :is(#borrowPage,#returnPage) .bw-h{font-size:14px;font-weight:700;color:var(--gray-800);margin:6px 0 0}
  :is(#borrowPage,#returnPage) .bw-quick{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  :is(#borrowPage,#returnPage) .bw-q{display:flex;flex-direction:column;align-items:center;gap:2px;padding:14px 8px;min-height:104px;background:#fff;border:1px solid var(--gray-200);border-radius:16px;cursor:pointer;font-family:inherit;text-align:center}
  :is(#borrowPage,#returnPage) .bw-q:active{background:var(--primary-bg)}
  :is(#borrowPage,#returnPage) .bw-q-ico{position:relative;width:44px;height:44px;border-radius:14px;background:var(--primary-bg);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:19px;margin-bottom:6px}
  :is(#borrowPage,#returnPage) .bw-q-t{font-size:13.5px;font-weight:600;color:var(--gray-800);line-height:1.25}
  :is(#borrowPage,#returnPage) .bw-q-s{font-size:12px;color:var(--gray-500)}
  :is(#borrowPage,#returnPage) .bw-q-badge{position:absolute;top:-7px;right:-9px;min-width:22px;height:22px;padding:0 6px;border-radius:11px;background:var(--danger);color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;border:2px solid #fff}
  :is(#borrowPage,#returnPage) .bw-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
  :is(#borrowPage,#returnPage) .bw-stat{display:flex;flex-direction:column;align-items:center;gap:2px;padding:12px 6px;background:#fff;border:1px solid var(--gray-200);border-radius:16px;text-align:center}
  :is(#borrowPage,#returnPage) .bw-stat i{font-size:15px;color:var(--primary);margin-bottom:4px}
  :is(#borrowPage,#returnPage) .bw-stat.ok i{color:var(--success)}
  :is(#borrowPage,#returnPage) .bw-stat.late i{color:var(--warning)}
  :is(#borrowPage,#returnPage) .bw-stat b{font-size:22px;font-weight:700;color:var(--gray-900);line-height:1.1}
  :is(#borrowPage,#returnPage) .bw-stat span{font-size:11.5px;color:var(--gray-500);line-height:1.25}

  /* sticky confirm bar */
  #borrowPage .br-bar{position:sticky;bottom:0;z-index:20;margin:0;padding:12px 16px calc(12px + env(safe-area-inset-bottom,0px));display:flex;align-items:center;gap:14px;background:#fff;border:1px solid var(--gray-200);border-radius:16px;box-shadow:0 -6px 20px rgba(76,29,149,.12)}
  #borrowPage .br-bar-sum{display:flex;flex-direction:column;flex:1;min-width:0}
  #borrowPage .br-bar-sum b{font-size:15px;font-weight:700;color:var(--gray-900)}
  #borrowPage .br-bar-sum small{font-size:12.5px;color:var(--gray-500);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #borrowPage .br-bar .btn-primary-full{width:auto;flex:none;min-width:160px;height:48px;padding:0 22px;font-size:15px;border-radius:12px}

  #borrowPage .br-sheet{padding:24px}
}
@media (min-width:600px) and (max-width:1200px){
  :is(#borrowPage,#returnPage) .bw-hero{flex-direction:row;align-items:center;justify-content:space-between}
  :is(#borrowPage,#returnPage) .bw-hero-text{text-align:left}
  :is(#borrowPage,#returnPage) .bw-quick{grid-template-columns:repeat(4,minmax(0,1fr))}
}

/* ═══ ≤ 768px — phone ═══ */
@media (max-width:768px){
  #borrowPage{--bw-pad:16px}
  #borrowPage .form-input-full,#borrowPage .bt-qty{font-size:16px}          /* stops iOS zooming in on focus */
  #borrowPage .btn-scan,#borrowPage .btn-upload{min-height:44px}
  #borrowPage .br-dd>div{min-height:44px}
  #borrowPage .bt-line{grid-template-columns:44px minmax(0,1fr);row-gap:10px}
  #borrowPage .bt-ctrl{grid-column:1/-1;padding-left:56px}
  #borrowPage .bt-del{margin-left:auto}
  #borrowPage .bt-step,#borrowPage .bt-del{width:40px;height:40px}
  #borrowPage .bt-qty{height:40px}
  #borrowPage .bt-add{padding:0 16px}
  #borrowPage .br-bar{margin:0 calc(-1*var(--bw-pad)) calc(-1*var(--bw-pad));border-radius:16px 16px 0 0;border-inline:0;border-bottom:0}
  #borrowPage .br-bar .btn-primary-full{min-width:150px;padding:0 16px}

  /* sheets: full screen with a purple app bar, like the reference screens */
  #borrowPage .br-sheet{padding:0;background:var(--gray-50);align-items:stretch}
  #borrowPage .br-sheet-card{max-width:none;max-height:none;height:100%;border-radius:0;box-shadow:none}
  #borrowPage .br-sheet-top{min-height:calc(56px + env(safe-area-inset-top,0px));padding-top:env(safe-area-inset-top,0px)}
  #borrowPage .br-sheet-foot{padding-bottom:calc(12px + env(safe-area-inset-bottom,0px))}

  /* toasts sit at the top so they never cover the sticky bar, the sheets' buttons or the scan panel */
  body.on-borrow .toast-container{top:calc(env(safe-area-inset-top,0px) + 10px);bottom:auto;left:12px;right:12px;pointer-events:none}
}
@media (prefers-reduced-motion:reduce){#borrowPage .bt-line.is-new{animation:none}}

/* Tablet portrait (769–960px): the header's search + icons + date (~500px) did not fit next to the sidebar, so every
   page scrolled sideways. The date chip is already hidden on phones; hide it in this range too. */
@media (min-width:769px) and (max-width:960px){
  .date-display{display:none}
  .search-box{width:200px}
}

/* ═══ ≤ 1200px — scan mode (phones + tablets) ═══
   html5-qrcode writes INLINE styles on the reader element (position:relative; border:1px solid silver; padding:0).
   Inline beats a normal stylesheet rule, so the reader stayed in the page flow underneath the dark scan overlay —
   the camera ran but was covered. The !important rules below win over those inline styles. */
@media (max-width:1200px){
  /* scan mode (phones AND tablets): dark camera area between a purple bar and a white control panel */
  #borrowPage .br-scan.on{display:block}
  #borrowPage .br-scan.on::before{content:"";position:fixed;inset:0;background:#0f0b1f;z-index:940}
  #borrowPage .br-scan-top{position:fixed;top:0;left:0;right:0;z-index:945;display:flex;align-items:center;gap:8px;height:calc(56px + env(safe-area-inset-top,0px));padding:env(safe-area-inset-top,0px) 8px 0;background:linear-gradient(90deg,var(--primary),var(--primary-dark));color:#fff}
  #borrowPage .br-scan-title{font-size:17px;font-weight:600}
  #borrowPage .br-scan-panel{position:fixed;left:0;right:0;bottom:0;z-index:945;display:flex;flex-direction:column;gap:10px;height:calc(214px + env(safe-area-inset-bottom,0px));padding:16px 16px calc(12px + env(safe-area-inset-bottom,0px));background:#fff;border-radius:22px 22px 0 0}
  #borrowPage .scanner-zone.is-live .qr-reader-viewport{position:fixed !important;left:0 !important;right:0 !important;top:calc(56px + env(safe-area-inset-top,0px)) !important;bottom:calc(214px + env(safe-area-inset-bottom,0px)) !important;width:auto !important;height:auto !important;margin:0 !important;padding:0 !important;border:0 !important;border-radius:0;background:#0f0b1f;z-index:942;display:flex !important;align-items:center;justify-content:center;overflow:hidden}
  #borrowPage .scanner-zone.is-live .qr-reader-viewport video{max-width:100% !important;max-height:100% !important;object-fit:cover}
  #borrowPage .qr-reader-viewport #qr-shaded-region>div{background-color:#22c55e !important}
  #borrowPage .br-seg{display:flex;gap:4px;padding:4px;background:var(--gray-100);border-radius:14px}
  #borrowPage .br-seg button{flex:1;height:42px;border:none;border-radius:11px;background:transparent;font:600 14px/1 inherit;font-family:inherit;color:var(--gray-600);cursor:pointer}
  #borrowPage .br-seg button.on{background:var(--primary);color:#fff;box-shadow:0 2px 8px rgba(109,40,217,.3)}
  #borrowPage .br-scan-status{min-height:38px;display:flex;align-items:center;font-size:13px;font-weight:500;padding:8px 12px;border-radius:10px;background:var(--primary-bg);color:var(--primary-dark)}
  #borrowPage .br-scan-status.success{background:var(--success-bg);color:#065f46}
  #borrowPage .br-scan-status.error{background:var(--danger-bg);color:#991b1b}
  #borrowPage .br-scan-tip{display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--gray-500);margin:0}
  #borrowPage .br-scan-tip i{color:var(--warning)}
  #borrowPage .br-scan-upload{height:44px;border-radius:12px;border:1.5px dashed var(--primary);background:var(--primary-bg);color:var(--primary);font:600 14px/1 inherit;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px;cursor:pointer}
}
  
/* =========================================
   STUDENT MASTERLIST IMPORT
   Responsive styles: Desktop, Tablet, Mobile
   ========================================= */

.sm-import-card {
    min-width: 0;
    width: 100%;
    overflow: hidden;
}

.sm-import-body {
    padding: 20px;
    min-width: 0;
}

.sm-import-body p {
    line-height: 1.6;
    overflow-wrap: anywhere;
}

/* Import instructions */
.sm-note {
    padding: 12px 15px;
    margin: 12px 0;
    border-left: 3px solid #64748b;
    border-radius: 5px;
    background: rgba(100, 116, 139, 0.08);
    line-height: 1.6;
}

/* Upload form */
.sm-import-form {
    display: grid;
    gap: 12px;
    width: 100%;
    max-width: 560px;
    margin: 18px 0;
}

.sm-import-form label {
    font-weight: 600;
}

.sm-import-form input[type="file"] {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding: 12px;
    border: 1px solid var(--border-color, #ddd);
    border-radius: 8px;
    background: var(--card-bg, #fff);
    box-sizing: border-box;
}

/* Preview summary */
.sm-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0;
}

.sm-summary span {
    flex: 0 1 auto;
    padding: 8px 12px;
    border: 1px solid var(--border-color, #ddd);
    border-radius: 8px;
    overflow-wrap: anywhere;
}

/* Update existing students option */
.sm-update-option {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 14px 0;
    line-height: 1.5;
}

.sm-update-option input[type="checkbox"] {
    flex: 0 0 auto;
    margin-top: 4px;
}

/* Preview table */
#studentImportPreview .table-container {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
}

#studentImportPreview .data-table {
    width: 100%;
    min-width: 700px;
    border-collapse: collapse;
}

#studentImportPreview .data-table th,
#studentImportPreview .data-table td {
    padding: 10px 12px;
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
}

/* Import status messages */
#studentImportMessage {
    margin: 10px 0;
    overflow-wrap: anywhere;
}

.sm-row-error {
    color: #b91c1c;
}

.sm-row-valid {
    color: #166534;
}

/* Action buttons */
.sm-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 16px;
}

.sm-actions button {
    max-width: 100%;
}

/* Keep the page from forcing horizontal scrolling */
#student-importPage,
#student-importPage .card {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
}

/* =========================================
   TABLET: 641px to 1024px
   ========================================= */
@media screen and (max-width: 1024px) {
    .sm-import-body {
        padding: 16px;
    }

    .sm-import-form {
        max-width: 100%;
    }

    .sm-summary {
        gap: 8px;
    }
}

/* =========================================
   MOBILE: 640px and below
   ========================================= */
@media screen and (max-width: 640px) {
    .sm-import-body {
        padding: 12px;
    }

    .sm-import-form {
        width: 100%;
        margin: 14px 0;
    }

    .sm-import-form input[type="file"] {
