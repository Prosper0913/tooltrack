.title-sub:empty{display:none;}
.title-sub.live{background:var(--primary-bg);color:var(--primary);}
.title-sub.conf-low{background:#fef3c7;color:#92400e;}
.title-sub.conf-medium{background:#dbeafe;color:#1e40af;}
.title-sub.conf-good{background:#d1fae5;color:#065f46;}
.month-nav{display:flex;align-items:center;gap:6px;}
.nav-arrow{width:34px;height:34px;border-radius:8px;border:1px solid var(--gray-200);background:white;color:var(--gray-600);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;transition:all .2s;}
