.kpi{background:var(--gray-50);border:1px solid var(--gray-100);border-radius:12px;padding:12px 14px;min-width:0;}
.kpi-label{font-size:12px;color:var(--gray-500);}
.kpi-value{font-size:22px;font-weight:700;color:var(--gray-800);line-height:1.3;}
