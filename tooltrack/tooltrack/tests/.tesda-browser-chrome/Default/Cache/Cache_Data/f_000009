/* ═══════════════════════════════════════════════════════════
   MOBILE POLISH — a broader pass beyond the sidebar drawer above.
   Breakpoints: 768px (tablet/phone), 640px (small phone/modals),
   480px (very small phone).
═══════════════════════════════════════════════════════════ */

/* ── Responsive tables: below 768px every .data-table keeps its normal
   row/column layout — no stacking into cards — and instead becomes a
   horizontally drag-scrollable table (same behavior across every table
   in the app, Tools included, matching the Borrowers table). Users can
   swipe with a finger, or click-and-drag with a mouse/trackpad, to pan
   sideways through the columns that don't fit a phone's width. ── */
@media(max-width:768px){
  .table-container{
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;
    scroll-behavior:smooth;
    cursor:grab;
    position:relative;
    scrollbar-width:thin;
    scrollbar-color:var(--gray-300) transparent;
  }
  .table-container:active{cursor:grabbing;}
  .table-container.dragging{cursor:grabbing;user-select:none;-webkit-user-select:none;}
  .table-container::-webkit-scrollbar{height:6px;}
  .table-container::-webkit-scrollbar-track{background:transparent;}
  .table-container::-webkit-scrollbar-thumb{background:var(--gray-300);border-radius:3px;}
  /* soft edge fade hints that there's more to scroll to the right */
  .table-container::after{
    content:"";
    position:absolute;top:0;right:0;bottom:0;width:28px;
    background:linear-gradient(to left, rgba(17,10,40,.06), rgba(17,10,40,0));
    pointer-events:none;
  }
  .data-table{min-width:640px;}
  .data-table th,.data-table td{white-space:nowrap;}
  .data-table td .tool-item,.data-table td .action-btns{white-space:normal;}
  .data-table td .action-btns{flex-wrap:nowrap;}
}
/* very small phones: a touch more breathing room isn't needed here —
   the drag-scroll already handles narrow viewports — but keep table
   text legible rather than shrinking it. */
@media(max-width:480px){
  .data-table th,.data-table td{padding:12px 14px;font-size:13px;}
}

/* ── Header ── */
@media(max-width:768px){
  .header{padding:0 16px;}
  .search-box{width:150px;}
  .date-display{display:none;}
  .breadcrumb{display:none;}
  .page-title{font-size:17px;}
}
@media(max-width:480px){
  .search-box{display:none;}
  #notifPanel{position:fixed !important;left:16px !important;right:16px !important;top:64px !important;width:auto !important;max-width:none !important;}
}

/* ── Page padding — desktop's generous 32px/24px padding eats too
   much of a phone's already-small width. ── */
@media(max-width:768px){
  .page-content{padding:16px;}
  .card-body{padding:16px;}
  .br-card-body{padding:16px;}
  .card-header{padding:16px;}
  .modal-body{padding:16px;}
  .modal-header{padding:16px;}
  .modal-footer{padding:12px 16px;}
}

/* ── Card headers on mobile: title on its own row, and the action
   buttons (Export, Replacement Requests, Submit Request, Add New
   Tool, etc.) arrange into a neat 2-column grid instead of four
   full-width bars stacked on top of each other. Text is allowed to
   wrap to a second line rather than overflow, and if there's an odd
   button left over it spreads across the full width on its own row. ── */
@media(max-width:640px){
  .card-header{flex-direction:column;align-items:stretch;gap:12px;}
  .card-actions{
    width:100%;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
  }
  .card-actions .card-btn{
    width:100%;
    white-space:normal;
    text-align:center;
    line-height:1.25;
    padding:10px 10px;
    font-size:12.5px;
  }
  .card-actions .card-btn:last-child:nth-child(odd){grid-column:1 / -1;}
}

/* ── Very small phones: shrink the action buttons a bit further so
   two still comfortably sit side by side. ── */
@media(max-width:480px){
  .card-actions{gap:6px;}
  .card-actions .card-btn{padding:9px 6px;font-size:11.5px;gap:5px;}
  .card-actions .card-btn i{font-size:11px;}
}

/* ── Extra-narrow phones: two columns gets too tight for longer
   labels like "Submit Replacement Request" — fall back to one
   full-width button per row so nothing feels cramped. ── */
@media(max-width:360px){
  .card-actions{grid-template-columns:1fr;}
  .card-actions .card-btn:last-child:nth-child(odd){grid-column:auto;}
}

/* ── Filter bars: each filter takes the full row instead of a
   cramped inline strip. ── */
@media(max-width:640px){
  .filter-bar{padding:12px 16px;gap:10px;}
  .filter-group{width:100%;}
  .filter-group .filter-select{flex:1;width:100%;}
  .filter-input{width:100%;}
  .filter-btn{flex:1;}
}

/* ── Pagination: stack instead of cramming info + buttons on one
   line (buttons were starting to wrap mid-number on narrow phones). ── */
@media(max-width:480px){
  .pagination{flex-direction:column;gap:10px;align-items:stretch;text-align:center;padding:12px 16px;}
}

/* ── Modals: keep clear of the screen edges, and stack footer
   buttons full-width instead of squeezing two buttons onto one
   cramped row. ── */
@media(max-width:640px){
  .modal-overlay{padding:12px;}
  .modal{width:100%;max-height:88vh;}
  .modal-footer{flex-wrap:wrap;}
  .modal-footer .btn{flex:1;min-width:0;}
}

/* ── Reports grid / cards ── */
@media(max-width:480px){
  .report-card{padding:16px;gap:14px;}
  .report-icon{width:48px;height:48px;font-size:20px;}
}

/* ── Scanner controls: slightly tighter so Camera/Stop/Upload fit
   without wrapping awkwardly on a small phone. ── */
@media(max-width:480px){
  .btn-scan,.btn-upload{min-width:0;font-size:12px;padding:10px;}
  .scanner-zone{padding:12px;}
}

/* ── Sidebar drawer: comfortable width on very narrow phones (a
   fixed 260px can be most of a small screen's width) and momentum
   scrolling for a long nav list. ── */
@media(max-width:360px){
  .sidebar{width:88vw;}
}
.sidebar-nav{-webkit-overflow-scrolling:touch;}

/* ── Stat cards: a bit tighter on very small phones. ── */
@media(max-width:480px){
  .stats-grid{gap:14px;}
  .stat-card{padding:16px;}
  .stat-value{font-size:26px;}
}

/* ═══════════════ REPORTS: monthly stats, trend & forecast ═══════════════ */
.card-header.wrap{flex-wrap:wrap;gap:12px;}
